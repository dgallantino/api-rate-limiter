FROM python:3.12-slim AS proto
RUN pip install --no-cache-dir grpcio-tools
WORKDIR /src
COPY proto proto
RUN mkdir -p python/gen \
	&& python -m grpc_tools.protoc \
		-I proto \
		--python_out=python/gen \
		--grpc_python_out=python/gen \
		check/v1/check.proto \
	&& touch python/gen/check/__init__.py python/gen/check/v1/__init__.py

FROM python:3.12-slim AS origin
RUN pip install --no-cache-dir fastapi uvicorn
WORKDIR /app
COPY demo/origin /app
EXPOSE 8000
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]

FROM python:3.12-slim AS origin-limited
RUN pip install --no-cache-dir fastapi uvicorn grpcio
WORKDIR /app
COPY python/src /app/src
COPY --from=proto /src/python/gen /app/gen
COPY demo/origin /app
ENV PYTHONPATH=/app/src:/app/gen
ENV CHECK_ADDR=check:50051
EXPOSE 8000
CMD ["uvicorn", "limited:app", "--host", "0.0.0.0", "--port", "8000"]
